# moai-note-api 환경변수
#
# 이 파일을 .env 로 복사해 쓴다. .env 는 커밋하지 않는다.
# 비밀값에는 기본값이 없다 — 없으면 기동이 실패한다.

# ── 필수 ────────────────────────────────────────────────
# 토큰 서명키. 32자 이상.
#   생성: openssl rand -base64 48
MOAI_NOTE_TOKEN_SECRET=

# 허용할 오리진 목록 (쉼표 구분). 와일드카드(*) 금지.
#   예: https://portal.example.com,https://admin.example.com
MOAI_NOTE_CORS_ORIGINS=

# ── 선택 ────────────────────────────────────────────────
MOAI_NOTE_PORT=7100
MOAI_NOTE_HOST=0.0.0.0
MOAI_NOTE_DB_PATH=./data/moai-note.db

# 액세스 토큰 만료(초)
MOAI_NOTE_TOKEN_TTL=3600

# HTTPS — 둘 다 설정하거나 둘 다 비운다.
# 비우면 http로 뜬다(리버스 프록시가 TLS를 종단하는 구성).
MOAI_NOTE_TLS_CERT=
MOAI_NOTE_TLS_KEY=

# 본문·제목 상한
MOAI_NOTE_MAX_CONTENT_BYTES=1000000
MOAI_NOTE_MAX_TITLE_LENGTH=300

# 문서당 리비전 보관 개수 (초과분은 오래된 것부터 삭제)
MOAI_NOTE_MAX_REVISIONS=50

# 에디터 번들 경로 — /embed.js 로 제공한다
MOAI_NOTE_EMBED_BUNDLE=../moai-note-editor-web/dist/embed.js

# 요청 빈도 제한
MOAI_NOTE_RATE_LIMIT_MAX=300
MOAI_NOTE_RATE_LIMIT_WINDOW=1 minute
