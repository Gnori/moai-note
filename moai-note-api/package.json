{
  "name": "moai-note-api",
  "version": "0.1.0",
  "private": true,
  "description": "moai-note 문서 저장 API — REST + MCP",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "client:add": "tsx src/auth/clientAdmin.ts add",
    "client:list": "tsx src/auth/clientAdmin.ts list",
    "client:revoke": "tsx src/auth/clientAdmin.ts revoke"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.2.0",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
